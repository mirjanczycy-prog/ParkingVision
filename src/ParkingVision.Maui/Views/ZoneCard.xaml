<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ParkingVision.Maui.ViewModels"
             xmlns:views="clr-namespace:ParkingVision.Maui.Views"
             x:Class="ParkingVision.Maui.Views.ZoneCard"
             x:DataType="vm:ZoneItemVm">
    <Border Style="{StaticResource Card}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenCommand}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />

            <HorizontalStackLayout Grid.Row="1" Spacing="10">
                <Label Text="{Binding DistanceText}" Style="{StaticResource Caption}" />
                <Label Text="{Binding BadgeText}" Style="{StaticResource Caption}"
                       TextColor="{Binding BadgeColor}" FontAttributes="Bold" />
                <Label Text="{Binding UpdatedText}" Style="{StaticResource Caption}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Column="1" Grid.RowSpan="2" VerticalOptions="Center">
                <Label Text="{Binding FreeText}" Style="{StaticResource BigNumber}" TextColor="{Binding AccentColor}" />
                <Label Text="{Binding TotalText}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
            </VerticalStackLayout>

            <views:CapacityBar Grid.Row="2" Grid.ColumnSpan="2"
                               Free="{Binding FreeLive}" Taken="{Binding OccupiedLive}" Unknown="{Binding WithoutLive}" />
        </Grid>
    </Border>
</ContentView>
