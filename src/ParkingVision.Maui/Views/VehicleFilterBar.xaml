<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ParkingVision.Maui.ViewModels"
             x:Class="ParkingVision.Maui.Views.VehicleFilterBar"
             x:DataType="vm:MapViewModel">
    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filters}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChipVm">
                    <Border Style="{StaticResource Chip}" BackgroundColor="{Binding Background}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Label}" TextColor="{Binding Foreground}" FontSize="13" FontAttributes="Bold" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
    </ScrollView>
</ContentView>
