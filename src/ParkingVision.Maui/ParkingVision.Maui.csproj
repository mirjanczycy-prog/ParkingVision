<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sources only. Platforms/ and Resources/{AppIcon,Splash,Images} come from `dotnet new maui` via scripts/bootstrap-maui.* -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <!-- Windows target omitted for now (not tested). -->

    <OutputType>Exe</OutputType>
    <RootNamespace>ParkingVision.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>ParkingVision</ApplicationTitle>
    <ApplicationId>pl.parkingvision.app</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E2A36" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E2A36" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.*" />
  </ItemGroup>

  <!-- Apple Maps only on Apple platforms (no key needed). Android uses Leaflet/OpenStreetMap in a WebView (see Views/Maps).
       PV_APPLE_MAPS is our own compile constant, defined exactly where the Maps package is referenced, so the #if blocks
       in code can never disagree with the package (do not rely on the SDK's IOS / MACCATALYST symbols). -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
    <DefineConstants>$(DefineConstants);PV_APPLE_MAPS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared DTOs: the app and the API can never drift apart on the contract. -->
    <ProjectReference Include="..\ParkingVision.Core\ParkingVision.Core.csproj" />
  </ItemGroup>

</Project>
